{
  "stringPrefix": [
    {"value":"abcdef", "count":3, "suffix":"", "expected":"abc"},
    {"value":"abcdef", "count":3, "suffix":"…", "expected":"abc…"},
    {"value":"abc", "count":8, "suffix":"…", "expected":"abc"},
    {"value":"", "count":0, "suffix":"", "expected":""},
    {"value":"A👨‍👩‍👧‍👦🇨🇳é中", "count":3, "suffix":"", "expected":"A👨‍👩‍👧‍👦🇨🇳"}
  ],
  "stringSuffix": [
    {"value":"abcdef", "count":3, "expected":"def"},
    {"value":"abc", "count":0, "expected":""},
    {"value":"abc", "count":8, "expected":"abc"},
    {"value":"A👨‍👩‍👧‍👦🇨🇳é中", "count":2, "expected":"é中"}
  ],
  "listObject": [
    {"values":[10,20,30], "index":1, "expected":20},
    {"values":[10,20,30], "index":-1, "expected":null},
    {"values":[10,20,30], "index":3, "expected":null},
    {"values":[], "index":0, "expected":null}
  ],
  "listChunked": [
    {"values":[1,2,3,4,5], "size":2, "expected":[[1,2],[3,4],[5]]},
    {"values":[], "size":2, "expected":[]},
    {"values":[1,2], "size":8, "expected":[[1,2]]}
  ],
  "clamped": [
    {"value":-1, "min":0, "max":10, "expected":0},
    {"value":11, "min":0, "max":10, "expected":10},
    {"value":5, "min":0, "max":10, "expected":5},
    {"kind":"nan", "min":0, "max":10},
    {"kind":"infinity", "min":0, "max":10, "expected":10},
    {"kind":"negativeInfinity", "min":0, "max":10, "expected":0}
  ]
}
